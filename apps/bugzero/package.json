    "directory": "apps/bugzero"
  },
  "bugs": {
    "url": "https://github.com/Saksham1800t/Bugzero/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "autofix",
    "auto-fix",
    "build-fixer",
    "bug-fix",
